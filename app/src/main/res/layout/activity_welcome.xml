<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fitsSystemWindows="true"
    tools:context=".WelcomeActivity">

    <!-- Ambient Decorative Glows for Visual Depth -->
    <View
        android:id="@+id/ambientGlowWelcome1"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:background="@drawable/bg_ambient_glow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:translationX="-120dp"
        android:translationY="-120dp" />

    <View
        android:id="@+id/ambientGlowWelcome2"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:background="@drawable/bg_ambient_glow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:translationX="100dp"
        android:translationY="100dp" />

    <View
        android:id="@+id/ambientGlowWelcome3"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@drawable/bg_ambient_glow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarWelcome"
        app:layout_constraintBottom_toTopOf="@+id/textLayoutWelcome"
        android:translationX="-60dp" />

    <!-- TOP APP BAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarWelcome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:contentInsetStart="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Left side: Book Icon & Title -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Book icon"
                    android:src="@drawable/ic_book"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Smart Study Focus"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.02" />
            </LinearLayout>

            <!-- Right side: Search Icon & Profile Icon -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnToolbarSearch"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:padding="6dp"
                    android:contentDescription="Search"
                    android:src="@drawable/ic_search"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="@color/white" />

                <ImageView
                    android:id="@+id/btnToolbarProfile"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="6dp"
                    android:contentDescription="Profile"
                    android:src="@drawable/ic_profile"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="@color/white" />
            </LinearLayout>

        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- SCROLLABLE CENTER CONTENT TO ENSURE PERFECT ADAPTIVE SPACING -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewWelcome"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/toolbarWelcome"
        app:layout_constraintBottom_toTopOf="@id/btnWelcomeStart">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp">

            <!-- CENTER ILLUSTRATION -->
            <FrameLayout
                android:id="@+id/illustrationContainerWelcome"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp">

                <!-- Outer Thin Ring (35% white opacity border) -->
                <View
                    android:id="@+id/bulbOuterRing"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_outer_circle_stroke" />

                <!-- Middle Thin Ring / Soft Glow -->
                <View
                    android:id="@+id/bulbMiddleGlow"
                    android:layout_width="125dp"
                    android:layout_height="125dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_ambient_glow" />

                <!-- Inner Filled Frosted Circular Container -->
                <FrameLayout
                    android:id="@+id/bulbInnerCircle"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_inner_circle_frosted">

                    <!-- Center solid white lightbulb -->
                    <ImageView
                        android:id="@+id/bulbLightImage"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:contentDescription="Glowing lightbulb"
                        android:src="@drawable/ic_lightbulb"
                        app:tint="@color/white" />
                </FrameLayout>
            </FrameLayout>

            <!-- CENTER TEXT: Stay Focused. Study Smarter. -->
            <LinearLayout
                android:id="@+id/textLayoutWelcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginBottom="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="Stay Focused.\nStudy Smarter."
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:alpha="0.85"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.2"
                    android:text="@string/onboarding_subtitle"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- FEATURES ROW SHORTCUTS -->
            <LinearLayout
                android:id="@+id/featuresRowWelcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Badge 1: Pomodoro Timer -->
                <LinearLayout
                    android:id="@+id/badgeWelcome1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_badge_chip"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/pomodoro_timer"
                        android:src="@drawable/ic_timer"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/pomodoro_timer"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Badge 2: Distraction Alerts -->
                <LinearLayout
                    android:id="@+id/badgeWelcome2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_badge_chip"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/distraction_alerts"
                        android:src="@drawable/ic_bell"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/distraction_alerts"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Badge 3: Focus Report -->
                <LinearLayout
                    android:id="@+id/badgeWelcome3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_badge_chip"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/focus_report"
                        android:src="@drawable/ic_chart"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/focus_report"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM ROUNDED WHITE BUTTON -->
    <RelativeLayout
        android:id="@+id/btnWelcomeStart"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="44dp"
        android:background="@drawable/bg_button_white"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Let's Start text in center -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif-medium"
            android:text="Let's Start"
            android:textColor="@color/gradient_red_end"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Arrow on the right -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="Forward arrow icon"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/gradient_red_end" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
