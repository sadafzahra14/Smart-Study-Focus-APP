<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="24dp"
    android:background="@drawable/bg_dialog_premium"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Glowing Alert Icon Badge -->
    <ImageView
        android:id="@+id/ivWarningIcon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="8dp"
        android:contentDescription="Distraction warning icon"
        android:src="@drawable/ic_distraction_warning" />

    <!-- Headline Title -->
    <TextView
        android:id="@+id/tvAlertTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-black"
        android:text="Focus Session Active"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- App Name Highlight Badge Container -->
    <LinearLayout
        android:id="@+id/layoutAppBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_badge_distraction_app"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvDistractedAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Distracting App"
            android:textColor="#FF3D40"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Context Explanation Text -->
    <TextView
        android:id="@+id/tvAlertMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:lineSpacingMultiplier="1.25"
        android:text="This application is blocked to help you stay on track. Return to your studies to successfully complete the session."
        android:textColor="#B3FFFFFF"
        android:textSize="14sp" />

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="24dp" />

    <!-- Interactive Options -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- Back to Study Button (Primary) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBackToStudy"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_button_gradient_pill"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Back to Study"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <!-- Continue Anyway / Deny Button (Secondary) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnContinueAnyway"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:padding="12dp"
            android:gravity="center"
            android:background="@drawable/bg_button_secondary_pill"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:fontFamily="sans-serif-medium"
            android:text="Deny"
            android:textAllCaps="false"
            android:textColor="#99FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>